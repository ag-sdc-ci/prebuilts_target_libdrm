prefix=/apex/org.blisslabs.ag.libdrm
includedir=${prefix}.dev/include
libdir=${prefix}/lib

Name: libdrm_radeon
Description: Userspace interface to kernel DRM services for radeon
Version: 2.4.134
Requires.private: libdrm
Libs: -L${libdir} -L${prefix}.dev/lib -ldrm_radeon
Libs.private: -pthread
Cflags: -I${includedir} -I${includedir}/libdrm
